# Copie para .env e preencha. NUNCA commite o .env (fica só neste PC).
# Use as chaves do aplicativo Omie da JCA Filial (Portal Omie > Configurações > Integrações > API).

OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_BASE_URL=https://app.omie.com.br/api/v1
OMIE_EMPRESA=JCA Filial

# sample = planilha de exemplo | omie = vendas ao vivo na API
DATA_SOURCE=sample

# Período padrão. Início: trimestre | mes | AAAA-MM-DD   Fim: hoje | AAAA-MM-DD
# (com DATA_SOURCE=sample use 2026-07-01 e 2026-09-30, o período da planilha)
DEFAULT_INICIO=trimestre
DEFAULT_FIM=hoje

# Cache no servidor (segundos) — evita estourar limite de chamadas Omie
CACHE_TTL=300
# Recarrega o painel no navegador a cada N segundos (0 = desligado)
PANEL_REFRESH_SEC=300

# Publicação para o Streamlit (scripts/publicar_dados.py). Gere a chave com:
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
PAINEL_DATA_KEY=
PAINEL_DATA_URL=https://raw.githubusercontent.com/lelisson/FATURAMENTOLOJAJCA/dados/painel.enc
